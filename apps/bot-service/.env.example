# Node environment
NODE_ENV=development
PORT=3000

# Claude API
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5

# AWS General
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# SQS
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/bot-processing-queue
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME=20
SQS_VISIBILITY_TIMEOUT=30

# DynamoDB
DYNAMODB_TABLE=bot_conversations
DYNAMODB_REGION=us-east-1

# Redis
REDIS_URL=redis://localhost:6379
SESSION_CACHE_TTL=3600

# LIS Backend
LIS_BACKEND_URL=https://192.168.4.95:8000
LIS_API_KEY=your-lis-api-key

# WhatsApp Service
WHATSAPP_SERVICE_URL=http://whatsapp-service:3000
